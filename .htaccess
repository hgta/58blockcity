RewriteEngine On
RewriteBase /

# Sitemap 重写：sitemap.xml 实际执行 sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 城市页伪静态（兼容旧 URL）
RewriteRule ^city/([a-z]+)\.html$ city.php?pinyin=$1 [L,QSA]

# 商城商品伪静态
RewriteRule ^mall/product/([0-9]+)-.*\.html$ mall/product/detail.php?id=$1 [B,L,QSA]

# 商城店铺伪静态
RewriteRule ^mall/shop/([0-9]+)-.*\.html$ mall/shop/view.php?id=$1 [B,L,QSA]

# 互访圈伪静态
RewriteRule ^circle/([0-9]+)-.*\.html$ hufang/circles/view.php?id=$1 [B,L,QSA]

# NFT 伪静态
RewriteRule ^nft/([0-9]+)-.*\.html$ nft/nft/view.php?id=$1 [B,L,QSA]

# 模特伪静态
RewriteRule ^mall/model/([0-9]+)-.*\.html$ mall/model/view.php?id=$1 [B,L,QSA]

# 强制 HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# 规范化 www 与非 www
# 主域已确定为 www.58.tl（见 openspec/changes/www-canonical-normalization）。
# 生产环境由 nginx 处理 301（见 docs/nginx-rewrite.conf 第 1b 节）。
# 若使用 Apache 且未在 nginx 层处理，取消下面两行注释：
# RewriteCond %{HTTP_HOST} ^58\.tl$ [NC]
# RewriteRule ^(.*)$ https://www.58.tl/$1 [L,R=301]

# 选项 B：强制非 www
# RewriteCond %{HTTP_HOST} ^www\.58\.tl$ [NC]
# RewriteRule ^(.*)$ https://58.tl/$1 [L,R=301]

# 自定义 404 页面
ErrorDocument 404 /404.php
